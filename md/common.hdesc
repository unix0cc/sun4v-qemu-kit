#define	CPU(n,g,v)		\
	node cpu cpu/**/n {	\
		pid = n;	\
		guest -> g;	\
		vid = v;	\
	}

#define	HVUART	0xfff0c2c000
#define	HVTOD	0xfff0c1fff8

#define	PUART(n)	(0x1f10000000 + (n * 0x2000))
#define	PUART0		0x1f10000000  /* XXX for legion .conf file */
#define	PUART1		0x1f10002000  /* XXX for legion .conf file */
#define	RESETADDR	0xfff0000000  /* XXX for legion .conf file */
#define	ROMBASE		0xfff0080000
#define	ROMSIZE		512k
#define	PERFCTRACCESS	1

#define	GUEST(n, gmembase, gmemsize, grealbase, gdiskpa) \
	node guest guest/**/n {			\
		pid = (n + 1);			\
		xid = (16 + n);			\
						\
		membase = gmembase;		\
		memsize = gmemsize;		\
		realbase = grealbase;		\
		uartbase = PUART(n);		\
		rombase = ROMBASE;		\
		romsize = ROMSIZE;		\
		diskpa = gdiskpa;		\
		perfctraccess = 1;		\
	}

/*
 * Macros and constants only, matching md/common.pdesc. The node definitions
 * live in md/legion/1up.hdesc and md/pci/1up.hdesc, each complete and free of
 * conditional compilation.
 */
