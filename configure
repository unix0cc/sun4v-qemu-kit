printf "%s\n" "no" >&6; }
    nfw_failed "$SUN_STUDIO/bin/cc cannot compile (see config.log; cc -V says: $SUN_CC_VERSION). Studio 12.5 and 12.6 need the VIS hwcap: isainfo -v, REQUIREMENTS.SOLARIS"; as_fn_error $? "$SUN_STUDIO/bin/cc cannot compile (see config.log; cc -V says: $SUN_CC_VERSION). Studio 12.5 and 12.6 need the VIS hwcap: isainfo -v, REQUIREMENTS.SOLARIS" "$LINENO" 5
  fi

      { printf "%s\n" "$as_me:${as_lineno-$LINENO}: checking whether the cc links a 64-bit program" >&5
printf %s "checking whether the cc links a 64-bit program... " >&6; }
  if nfw_try 'int main(void) { return 0; }' "$SUN_STUDIO/bin/cc" -xarch=v9 -o conftest conftest.c; then
