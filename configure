# Handling of arguments.
for ac_config_target in $ac_config_targets
do
  case $ac_config_target in
    "config.auto.mk") CONFIG_FILES="$CONFIG_FILES config.auto.mk" ;;
    "oot-makefile") CONFIG_COMMANDS="$CONFIG_COMMANDS oot-makefile" ;;

