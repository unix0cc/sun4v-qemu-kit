then :
  printf %s "(cached) " >&6
else case e in #(
  e)
      if nfw_emu_run "$QEMU_SPARC64" m64; then nfw_cv_emu64=yes; else nfw_cv_emu64=no; fi ;;
esac
fi
{ printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: $nfw_cv_emu64" >&5
printf "%s\n" "$nfw_cv_emu64" >&6; }
    test "$nfw_cv_emu64" = yes || nfw_missing="$nfw_missing qemu-sparc64(cannot run a static -m64 program: config.log)"
  fi
  if test -n "$QEMU_SPARC32"; then
    { printf "%s\n" "$as_me:${as_lineno-$LINENO}: checking whether $QEMU_SPARC32 runs a static -m32 program" >&5
printf %s "checking whether $QEMU_SPARC32 runs a static -m32 program... " >&6; }
