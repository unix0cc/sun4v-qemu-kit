@@ -49,6 +49,7 @@
 #pragma ident	"@(#)mdmain.c	1.3	07/06/07 SMI"
 
 #include <stdio.h>
+#include <inttypes.h>
 #include <stdlib.h>
 #include <unistd.h>
 #include <fcntl.h>
@@ -396,7 +397,7 @@
 				    pep->u.strp);
 				break;
 			case PE_int:
-				fprintf(fp, "\t%s = 0x%llx;\n", pep->namep,
+				fprintf(fp, "\t%s = 0x%" PRIx64 ";\n", pep->namep,
